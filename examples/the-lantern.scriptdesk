   "elements": [
    {
     "id": "ex00093",
     "type": "scene",
     "text": "SCENE 1. A LIGHTHOUSE. NIGHT."
    },
    {
     "id": "ex00094",
     "type": "sound",
     "text": "WIND HOWLS AROUND STONE. A HEAVY DOOR SLAMS."
    },
    {
     "id": "ex00095",
     "type": "music",
     "text": "A LOW CELLO NOTE, HELD."
    },
    {
     "id": "ex00096",
     "type": "action",
     "text": "Footsteps on an iron spiral staircase, climbing, slowing."
    },
    {
     "id": "ex00097",
     "type": "character",
     "text": "GRETA"
    },
    {
     "id": "ex00098",
     "type": "parenthetical",
     "text": "(out of breath)"
    },
    {
     "id": "ex00099",
     "type": "dialogue",
     "text": "Two hundred and twelve steps. Every night for thirty years, and I still count them."
    },
    {
     "id": "ex0009a",
     "type": "sound",
     "text": "A MATCH STRIKES. A HISS AS THE LAMP CATCHES."
    },
    {
     "id": "ex0009b",
     "type": "character",
     "text": "GRETA"
    },
    {
     "id": "ex0009c",
     "type": "dialogue",
     "text": "There you are, old friend. Let's see who's out there tonight."
    },
    {
     "id": "ex0009d",
     "type": "sound",
     "text": "FAINT, FAR OFF — A SHIP'S HORN. ONCE. TWICE."
    },
    {
     "id": "ex0009e",
     "type": "character",
     "text": "GRETA"
    },
    {
     "id": "ex0009f",
     "type": "parenthetical",
     "text": "(sharp)"
    },
    {
     "id": "ex0009g",
     "type": "dialogue",
     "text": "That's not a ship I know."
    },
    {
     "id": "ex0009h",
     "type": "scene",
     "text": "SCENE 2. THE LANTERN ROOM. LATER."
    },
    {
     "id": "ex0009i",
     "type": "sound",
     "text": "THE LAMP TURNS WITH A SLOW MECHANICAL TICK."
    },
    {
     "id": "ex0009j",
     "type": "character",
     "text": "RADIO VOICE"
    },
    {
     "id": "ex0009k",
     "type": "parenthetical",
     "text": "(distorted, through static)"
    },
    {
     "id": "ex0009l",
     "type": "dialogue",
     "text": "Lighthouse... lighthouse, this is the Esperanza... we see your light... we've been seeing it for sixty years...",
     "fmt": [
      [
       38,
       47,
       2
      ]
     ]
    },
    {
     "id": "ex0009m",
     "type": "music",
     "text": "THE CELLO RISES, UNEASY."
    },
    {
     "id": "ex0009n",
     "type": "character",
     "text": "GRETA"
    },
    {
     "id": "ex0009o",
     "type": "dialogue",
     "text": "The Esperanza sank in nineteen sixty-four."
    },
    {
     "id": "ex0009p",
     "type": "sound",
     "text": "STATIC SWALLOWS THE VOICE. ONLY WIND."
    }
   ]
  }
 ],
