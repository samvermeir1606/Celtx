    "draftDate": "Example draft",
    "contact": ""
   },
   "elements": [
    {
     "id": "ex00064",
     "type": "act",
     "text": "TEASER"
    },
    {
     "id": "ex00065",
     "type": "scene",
     "text": "INT. ST. AUGUSTA HOSPITAL - EMERGENCY ROOM - NIGHT"
    },
    {
     "id": "ex00066",
     "type": "action",
     "text": "Fluorescent hum. A vending machine clunks. Empty plastic chairs."
    },
    {
     "id": "ex00067",
     "type": "action",
     "text": "DR. IMANI COLE (30s), scrubs, coffee in each hand, pushes through the doors with her hip."
    },
    {
     "id": "ex00068",
     "type": "character",
     "text": "IMANI"
    },
    {
     "id": "ex00069",
     "type": "dialogue",
     "text": "Who ordered the quiet? Because I want a refund."
    },
    {
     "id": "ex0006a",
     "type": "action",
     "text": "The ambulance doors BANG open. Two PARAMEDICS wheel in a gurney. On it: a man in a tuxedo, soaking wet, laughing.",
     "fmt": [
      [
       104,
       112,
       2
      ]
     ]
    },
    {
     "id": "ex0006b",
     "type": "character",
     "text": "PARAMEDIC"
    },
    {
     "id": "ex0006c",
     "type": "dialogue",
     "text": "Found him in the river. Says he's fine. Says his name is Frank Sinatra."
    },
    {
     "id": "ex0006d",
     "type": "character",
     "text": "IMANI"
    },
    {
     "id": "ex0006e",
     "type": "parenthetical",
     "text": "(setting the coffees down)"
    },
    {
     "id": "ex0006f",
     "type": "dialogue",
     "text": "They always are."
    },
    {
     "id": "ex0006g",
     "type": "act",
     "text": "END OF TEASER"
    },
    {
     "id": "ex0006h",
     "type": "act",
     "text": "ACT ONE"
    },
    {
     "id": "ex0006i",
     "type": "scene",
     "text": "INT. ER - TRAUMA BAY 2 - CONTINUOUS"
    },
    {
     "id": "ex0006j",
     "type": "action",
     "text": "Imani shines a light in \"FRANK's\" eyes. Mid 50s, silver hair, wedding ring."
    },
    {
     "id": "ex0006k",
     "type": "character",
     "text": "FRANK"
    },
    {
     "id": "ex0006l",
     "type": "dialogue",
     "text": "You have kind eyes. Tired, but kind."
    },
    {
     "id": "ex0006m",
     "type": "character",
     "text": "IMANI"
    },
    {
     "id": "ex0006n",
     "type": "dialogue",
     "text": "I've been awake for nineteen hours. Who are you really?"
    },
    {
     "id": "ex0006o",
     "type": "character",
     "text": "FRANK"
    },
    {
     "id": "ex0006p",
     "type": "dialogue",
     "text": "Tonight? Somebody who finally did something brave."
    },
    {
     "id": "ex0006q",
     "type": "action",
     "text": "Imani notices a hospital bracelet already on his wrist. Faded. From this hospital.",
     "fmt": [
      [
       68,
       72,
       2
      ]
     ]
    },
    {
     "id": "ex0006r",
     "type": "scene",
     "text": "INT. ER - NURSES' STATION - NIGHT"
    },
    {
     "id": "ex0006s",
     "type": "action",
     "text": "Charge nurse BEN OKAFOR (40s) types with two fingers. Imani slaps the old bracelet on the desk."
    },
    {
     "id": "ex0006t",
     "type": "character",
     "text": "IMANI"
    },
    {
     "id": "ex0006u",
     "type": "dialogue",
     "text": "Run this number."
    },
    {
     "id": "ex0006v",
     "type": "character",
     "text": "BEN"
    },
    {
     "id": "ex0006w",
     "type": "dialogue",
     "text": "That's an old system number. Before the merger."
    },
    {
     "id": "ex0006x",
     "type": "character",
     "text": "IMANI"
    },
    {
     "id": "ex0006y",
     "type": "dialogue",
     "text": "So it's old. Run it anyway.",
     "fmt": [
      [
       8,
       11,
       4
      ]
     ]
    },
    {
     "id": "ex0006z",
     "type": "action",
     "text": "Ben types. Stops. Looks up."
    },
    {
     "id": "ex00070",
     "type": "character",
     "text": "BEN"
    },
    {
     "id": "ex00071",
     "type": "dialogue",
     "text": "Imani. This man died here. Eleven years ago."
    },
    {
     "id": "ex00072",
     "type": "act",
     "text": "END OF ACT ONE"
    }
   ]
  },
