  {
   "id": "ex0002i",
   "category": "location",
   "name": "FERRY",
   "description": "The Margit, a 1968 car ferry. Rented with her own crew.",
   "tags": "",
   "fields": {
    "price": "1800",
    "priceUnit": "per shoot day",
    "facilities": "Working car ferry with crew, 3 vehicles on deck",
    "lat": "55.040000",
    "lng": "10.598000",
    "meaning": "For Elsa: her marriage, her work, her whole adult life. For Noor: an escape route. For Tomas: the thing he is replacing.",
    "power": "Elsa rules the bridge of the ship. Everyone else is a passenger — until the engine dies.",
    "onlyHere": "Two strangers trapped together with nowhere to walk away to.",
    "placeSecret": "Her husband’s initials are scratched into the engine room door.",
    "placeChange": "From the place Elsa hides to the place she shares with her son.",
    "sound": "The diesel thrum, a loose chain rattling on the car deck, gulls.",
    "smell": "Diesel, salt, wet rope, coffee.",
    "light": "Flat grey daylight, then the green pier lamp through the fog.",
    "temperature": "Cold wind on deck; the wheelhouse warm and fogged up."
   },
