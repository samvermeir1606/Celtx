    "contact": ""
   },
   "elements": [
    {
     "id": "ex00003",
     "type": "scene",
     "text": "EXT. HARBOUR - DAWN",
     "synopsis": "Elsa readies the old ferry for its last day. Across the water, the new bridge is nearly finished.",
     "color": "",
     "temp": 2,
     "timing": {
      "manual": 58
     },
     "items": [
      "ex0002f",
      "ex0002l"
     ]
    },
    {
     "id": "ex00004",
     "type": "action",
     "text": "Fog sits low on the water. Gulls. A small car ferry, the MARGIT, rocks against the quay, rust showing through white paint."
    },
    {
     "id": "ex00005",
     "type": "action",
     "text": "Across the strait, the grey arch of a new bridge is almost closed. One last section hangs from a crane.",
     "fmt": [
      [
       38,
       48,
       2
      ]
     ]
    },
    {
     "id": "ex00006",
     "type": "action",
     "text": "ELSA (70s), wool cap, hands like rope, coils a mooring line the way she has done ten thousand times."
    },
    {
     "id": "ex00007",
     "type": "action",
     "text": "She pats the ferry's hull."
    },
    {
     "id": "ex00008",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex00009",
     "type": "dialogue",
     "text": "One more. Then you can sleep."
    },
    {
     "id": "ex0000a",
     "type": "scene",
     "text": "INT. FERRY WHEELHOUSE - DAWN",
     "synopsis": "Her son Tomas, the bridge engineer, calls on the radio. She refuses to come to the opening.",
     "temp": 3,
     "items": [
      "ex0002j",
      "ex0002l"
     ]
    },
    {
     "id": "ex0000b",
     "type": "action",
     "text": "Brass, wood, a cracked leather seat. The VHF RADIO crackles."
    },
    {
     "id": "ex0000c",
     "type": "character",
     "text": "TOMAS (V.O.)"
    },
    {
     "id": "ex0000d",
     "type": "parenthetical",
     "text": "(on radio)"
    },
    {
     "id": "ex0000e",
     "type": "dialogue",
     "text": "Mum. Margit. Come in, Margit."
    },
    {
     "id": "ex0000f",
     "type": "action",
     "text": "Elsa lets it ring twice more before she picks up the handset."
    },
    {
     "id": "ex0000g",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex0000h",
     "type": "dialogue",
     "text": "Margit here."
    },
    {
     "id": "ex0000i",
     "type": "character",
     "text": "TOMAS (V.O.)"
    },
    {
     "id": "ex0000j",
     "type": "dialogue",
     "text": "The ceremony is at four. They kept you a seat. Front row."
    },
    {
     "id": "ex0000k",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex0000l",
     "type": "dialogue",
     "text": "I have a crossing at four."
    },
    {
     "id": "ex0000m",
     "type": "character",
     "text": "TOMAS (V.O.)"
    },
    {
     "id": "ex0000n",
     "type": "dialogue",
     "text": "There is no crossing at four. That's the point.",
     "fmt": [
      [
       41,
       46,
       4
      ]
     ]
    },
    {
     "id": "ex0000o",
     "type": "action",
     "text": "She hangs the handset back on its hook. Gently. Then she starts the engine."
    },
    {
     "id": "ex0000p",
     "type": "scene",
     "text": "INT. FERRY CAR DECK - DAY",
     "synopsis": "Elsa finds Noor, a runaway teenager, hiding in a delivery van.",
     "temp": 6,
     "items": [
      "ex0002m",
      "ex0002k"
     ]
    },
    {
     "id": "ex0000q",
     "type": "action",
     "text": "Three vehicles. A camper, a farm truck, and a white DELIVERY VAN with its back door not quite shut."
    },
    {
     "id": "ex0000r",
     "type": "action",
     "text": "Elsa walks the deck, checking straps. She stops. Listens. A phone buzzes inside the van.",
     "fmt": [
      [
       66,
       72,
       2
      ]
     ]
    },
    {
     "id": "ex0000s",
     "type": "action",
     "text": "She yanks the door open. NOOR (16), hood up, backpack clutched to her chest, stares back."
    },
    {
     "id": "ex0000t",
     "type": "character",
     "text": "NOOR"
    },
    {
     "id": "ex0000u",
     "type": "dialogue",
     "text": "I paid. I paid the driver."
    },
    {
     "id": "ex0000v",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex0000w",
     "type": "dialogue",
     "text": "The driver doesn't own my boat."
    },
    {
     "id": "ex0000x",
     "type": "action",
     "text": "The phone buzzes again. MUM on the screen. Noor kills it.",
     "fmt": [
      [
       24,
       27,
       2
      ]
     ]
    },
    {
     "id": "ex0000y",
     "type": "scene",
     "text": "EXT. FERRY DECK - DAY",
     "synopsis": "On the open deck they trade stories. Noor is running away; Elsa remembers her first crossing.",
     "color": "",
     "temp": 4,
     "timing": {
      "read": 96
     },
     "items": [
      "ex0002i",
      "ex0002l",
      "ex0002k"
     ]
    },
    {
     "id": "ex0000z",
     "type": "action",
     "text": "Wind. Spray. Elsa pours coffee from a dented THERMOS into two cups. Noor takes one without saying thanks."
    },
    {
     "id": "ex00010",
     "type": "character",
     "text": "NOOR"
    },
    {
     "id": "ex00011",
     "type": "dialogue",
     "text": "Everyone says the bridge is better. Ten minutes instead of forty."
    },
    {
     "id": "ex00012",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex00013",
     "type": "dialogue",
     "text": "Everyone is right."
    },
    {
     "id": "ex00014",
     "type": "character",
     "text": "NOOR"
    },
    {
     "id": "ex00015",
     "type": "dialogue",
     "text": "So why are you still doing this?"
    },
    {
     "id": "ex00016",
     "type": "action",
     "text": "Elsa looks at the water a long moment."
    },
    {
     "id": "ex00017",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex00018",
     "type": "dialogue",
     "text": "My father let me steer when I was younger than you. I thought the island moved toward us. Every time. Like it was coming to meet me."
    },
    {
     "id": "ex00019",
     "type": "character",
     "text": "NOOR"
    },
    {
     "id": "ex0001a",
     "type": "parenthetical",
     "text": "(small)"
    },
    {
     "id": "ex0001b",
     "type": "dialogue",
     "text": "Where I'm going, nobody comes to meet you.",
     "comments": [
      {
       "id": "ex00028",
       "text": "Best line in the script. Keep it.",
       "quote": "",
       "start": 0,
       "end": 0,
       "created": "2026-01-10T10:05:00.000Z",
       "done": false,
       "author": "Anna (reader)"
      }
     ]
    },
    {
     "id": "ex0001c",
     "type": "scene",
     "text": "INT. FERRY WHEELHOUSE - DAY",
     "synopsis": "The engine falters in the fog. Elsa puts Noor at the wheel while she fixes it.",
     "temp": 9,
     "items": [
      "ex0002q",
      "ex0002l"
     ]
    },
    {
     "id": "ex0001d",
     "type": "action",
     "text": "The engine coughs. Stops. Silence, except for the water.",
     "comments": [
      {
       "id": "ex00027",
       "text": "Could we hear the silence for longer here? Hold on the fog.",
       "quote": "Silence, except for the water.",
       "start": 23,
       "end": 54,
       "created": "2026-01-10T10:00:00.000Z",
       "done": false,
       "author": "Anna (reader)"
      }
     ]
    },
    {
     "id": "ex0001e",
     "type": "action",
     "text": "Elsa grabs a toolbox. Points at the wheel."
    },
    {
     "id": "ex0001f",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex0001g",
     "type": "dialogue",
     "text": "Keep her nose on the light. Don't let the current turn you."
    },
    {
     "id": "ex0001h",
     "type": "character",
     "text": "NOOR"
    },
    {
     "id": "ex0001i",
     "type": "dialogue",
     "text": "I can't drive a boat!"
    },
    {
     "id": "ex0001j",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex0001k",
     "type": "dialogue",
     "text": "Nobody can. You just argue with it."
    },
    {
     "id": "ex0001l",
     "type": "action",
     "text": "Elsa disappears below. Noor grips the wheel. Through the fog, a GREEN LIGHT blinks on the island pier."
    },
    {
     "id": "ex0001m",
     "type": "action",
     "text": "The engine catches. Noor laughs, surprised at herself."
    },
    {
     "id": "ex0001n",
     "type": "scene",
     "text": "EXT. ISLAND PIER - DAY",
     "synopsis": "Tomas is waiting at the pier. Noor calls her mother.",
     "temp": 5,
     "items": [
      "ex0002h",
      "ex0002k"
     ]
    },
    {
     "id": "ex0001o",
     "type": "action",
     "text": "The Margit bumps the pier. TOMAS (40s), hard hat under his arm, catches the line before Elsa can throw it."
    },
    {
     "id": "ex0001p",
     "type": "character",
     "text": "TOMAS"
    },
    {
     "id": "ex0001q",
     "type": "dialogue",
     "text": "You could have just said no on the radio."
    },
    {
     "id": "ex0001r",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex0001s",
     "type": "dialogue",
     "text": "I did say no."
    },
    {
     "id": "ex0001t",
     "type": "character",
     "text": "TOMAS"
    },
    {
     "id": "ex0001u",
     "type": "dialogue",
     "text": "Mum, about the bridge —"
    },
    {
     "id": "ex0001v",
     "type": "character",
     "text": "ELSA",
     "dual": true
    },
    {
     "id": "ex0001w",
     "type": "dialogue",
     "text": "Don't you dare thank me."
    },
    {
     "id": "ex0001x",
     "type": "action",
     "text": "Behind them Noor holds her phone to her ear. She turns away to talk. We don't hear it. We see her nod."
    },
    {
     "id": "ex0001y",
     "type": "scene",
     "text": "EXT. FERRY DECK - DUSK",
     "synopsis": "The last crossing home: Elsa, Tomas and the ferry pass under the new bridge.",
     "color": "",
     "temp": 7,
     "items": [
      "ex0002l"
     ],
     "versionName": "Under the bridge",
     "versions": [
      {
       "id": "ex00056",
       "name": "At the ceremony",
       "created": "2026-01-12T09:00:00.000Z",
       "elements": [
        {
         "id": "ex00057",
         "type": "action",
         "text": "Elsa ties up the Margit for the last time. Up on the bridge, a brass band starts to play."
        },
        {
         "id": "ex00058",
         "type": "action",
         "text": "She climbs the stairs to the ceremony in her captain’s coat. Tomas sees her and stops mid-speech."
        },
        {
         "id": "ex00059",
         "type": "character",
         "text": "TOMAS"
        },
        {
         "id": "ex0005a",
         "type": "dialogue",
         "text": "The front row is still free."
        },
        {
         "id": "ex0005b",
         "type": "transition",
         "text": "FADE OUT."
        }
       ]
      }
     ]
    },
    {
     "id": "ex0001z",
     "type": "action",
     "text": "The Margit crosses back. Tomas stands beside his mother at the rail. Above them the bridge is lit for the ceremony."
    },
    {
     "id": "ex00020",
     "type": "action",
     "text": "The ferry passes under it. For a moment the whole deck is in shadow.",
     "fmt": [
      [
       17,
       22,
       2
      ]
     ]
    },
    {
     "id": "ex00021",
     "type": "character",
     "text": "TOMAS"
    },
    {
     "id": "ex00022",
     "type": "dialogue",
     "text": "You know you'll be able to drive across in ten minutes."
    },
    {
     "id": "ex00023",
     "type": "character",
     "text": "ELSA"
    },
    {
     "id": "ex00024",
     "type": "dialogue",
     "text": "I know."
    },
    {
     "id": "ex00025",
     "type": "action",
     "text": "On the shrinking pier, Noor waves. Elsa lifts one hand from the rail."
    },
    {
     "id": "ex00026",
     "type": "transition",
     "text": "FADE OUT."
    }
   ]
  },
