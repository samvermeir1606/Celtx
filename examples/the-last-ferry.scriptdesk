  {
   "id": "ex00059",
   "kind": "note",
   "name": "Ideas & research",
   "text": "Research Real ferries replaced by bridges: talk to a retired captain VHF radio etiquette: “Margit, Margit, this is…” Possible title The Last Ferry / Crossing / Margit",
   "html": "<h2>Research</h2><ul><li>Real ferries replaced by bridges: talk to a retired captain</li><li>VHF radio etiquette: “Margit, Margit, this is…”</li></ul><h3>Possible title</h3><p><b>The Last Ferry</b> / <i>Crossing</i> / <i>Margit</i></p>",
   "about": []
  },
  {
   "id": "ex00057",
   "kind": "note",
   "name": "Elsa — notes",
   "text": "Elsa She never says what she feels. She does things: the coffee, the steering wheel, the hand on the hull. 41 years on the same crossing Husband Jens died six years ago — he kept the engine running Doesn’t hate the bridge. Hates being thanked . “Nobody can drive a boat. You just argue with it.”",
   "html": "<h2>Elsa</h2><p>She never says what she feels. She <b>does</b> things: the coffee, the steering wheel, the hand on the hull.</p><ul><li>41 years on the same crossing</li><li>Husband Jens died six years ago — he kept the engine running</li><li>Doesn’t hate the bridge. Hates being <i>thanked</i>.</li></ul><blockquote>“Nobody can drive a boat. You just argue with it.”</blockquote>",
   "about": [
    "ex00029"
   ],
   "folder": "ex00056"
  },
  {
   "id": "ex00058",
   "kind": "note",
   "name": "Noor — notes",
   "text": "Noor Not running from something dramatic. Running because nobody noticed she was sad. Her cousin on the island doesn’t know she’s coming. The phone call on the pier is the turn: she lets her mother come and get her.",
   "html": "<h2>Noor</h2><p>Not running <i>from</i> something dramatic. Running because nobody noticed she was sad.</p><p>Her cousin on the island doesn’t know she’s coming. The phone call on the pier is the turn: she lets her mother come and get her.</p>",
   "about": [
    "ex0002a"
   ],
   "folder": "ex00056"
  }
 ],
 "catalog": [
  {
   "id": "ex00029",
   "category": "character",
   "name": "ELSA",
   "description": "Has run the Margit for 41 years. Her late husband was the engineer.",
   "tags": "",
   "fields": {
    "age": "Early 70s",
    "occupation": "Ferry captain",
    "want": "To make the last crossing on her own terms",
    "need": "To let her son into her world before it disappears",
    "personality": "Dry, stubborn, kind in actions rather than words",
    "needScenes": [
     "ex0001y"
    ],
    "contradiction": "A ferry captain who has never once let anyone else steer",
    "strengthWeakness": "Her self-reliance kept the ferry running for 41 years — and keeps her son at arm’s length.",
    "stakesStart": "Her pride: being seen at the opening of the bridge that ends her job.",
    "stakesMid": "A sixteen-year-old in her care, in fog, with a failing engine.",
    "stakesEnd": "Her son. If she refuses him today, there is no ferry left to share.",
    "wound": "Her husband, the ferry’s engineer, died at sea. She kept working the next morning.",
    "woundScenes": [
     "ex0000y"
    ],
    "lie": "If you need no one, no one can be taken from you.",
    "truth": "Letting someone in is not the same as losing them.",
    "secret": "She has already accepted a job at the bridge’s visitor centre.",
    "secretFrom": "Tomas",
    "line": "No one else steers the Margit.",
    "lineScenes": [
     "ex0001c"
    ]
   },
   "links": {
    "playedBy": "ex0002c"
   },
   "media": [],
   "custom": [],
   "arcs": [
    {
     "id": "ex0002f",
     "label": "Letting her son in",
     "low": "shut out",
     "high": "side by side",
     "points": {
      "ex00003": 1,
      "ex0000a": 0,
      "ex0000y": 2,
      "ex0001c": 3,
      "ex0001n": 6,
      "ex0001y": 9
     }
    }
   ],
   "interview": [
    {
     "id": "ex0002t",
     "cat": "Under pressure",
     "q": "What is the first thing they would grab if their home was on fire?",
     "a": "The logbook. Every crossing since 1983, in her handwriting and his."
    },
    {
     "id": "ex0002u",
     "cat": "In this story",
     "q": "What would happen to them if the story never started?",
     "a": "She would sail the last crossing alone, tie up, and never come back to the harbour."
    }
   ]
  },
  {
