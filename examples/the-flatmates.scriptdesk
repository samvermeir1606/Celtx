   "elements": [
    {
     "id": "ex00084",
     "type": "act",
     "text": "ACT ONE"
    },
    {
     "id": "ex00085",
     "type": "scene",
     "text": "INT. FLAT - KITCHEN - MORNING"
    },
    {
     "id": "ex00086",
     "type": "action",
     "text": "Dishes everywhere. A sad, nearly dead house plant on the windowsill. LIV (late 20s) stares at it."
    },
    {
     "id": "ex00087",
     "type": "character",
     "text": "LIV"
    },
    {
     "id": "ex00088",
     "type": "dialogue",
     "text": "Sam. The plant."
    },
    {
     "id": "ex00089",
     "type": "character",
     "text": "SAM"
    },
    {
     "id": "ex0008a",
     "type": "dialogue",
     "text": "What about the plant?"
    },
    {
     "id": "ex0008b",
     "type": "character",
     "text": "LIV"
    },
    {
     "id": "ex0008c",
     "type": "dialogue",
     "text": "It's dead, Sam."
    },
    {
     "id": "ex0008d",
     "type": "character",
     "text": "SAM"
    },
    {
     "id": "ex0008e",
     "type": "parenthetical",
     "text": "(offended)"
    },
    {
     "id": "ex0008f",
     "type": "dialogue",
     "text": "It's resting.",
     "fmt": [
      [
       5,
       12,
       2
      ]
     ]
    },
    {
     "id": "ex0008g",
     "type": "action",
     "text": "SAM (late 20s) waters it with cold coffee."
    },
    {
     "id": "ex0008h",
     "type": "character",
     "text": "LIV"
    },
    {
     "id": "ex0008i",
     "type": "dialogue",
     "text": "My mother gave me that plant. She's coming on Saturday."
    },
    {
     "id": "ex0008j",
     "type": "character",
     "text": "SAM"
    },
    {
     "id": "ex0008k",
     "type": "dialogue",
     "text": "Then we have four days to perform a miracle."
    },
    {
     "id": "ex0008l",
     "type": "scene",
     "text": "INT. GARDEN CENTRE - DAY"
    },
    {
     "id": "ex0008m",
     "type": "action",
     "text": "Sam holds up two identical plants to a bored SHOP ASSISTANT (20s)."
    },
    {
     "id": "ex0008n",
     "type": "character",
     "text": "SAM"
    },
    {
     "id": "ex0008o",
     "type": "dialogue",
     "text": "Which one looks more like it's been loved for three years?"
    },
    {
     "id": "ex0008p",
     "type": "character",
     "text": "SHOP ASSISTANT"
    },
    {
     "id": "ex0008q",
     "type": "dialogue",
     "text": "They're both from Tuesday."
    },
    {
     "id": "ex0008r",
     "type": "character",
     "text": "SAM"
    },
    {
     "id": "ex0008s",
     "type": "dialogue",
     "text": "Perfect. Wrap the sadder one."
    },
    {
     "id": "ex0008t",
     "type": "act",
     "text": "END OF ACT ONE"
    }
   ]
  }
